# Production Environment Variables
# Copy to .env.production and fill in your values

# Database (Neon or local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname?sslmode=require
# Use Neon’s direct/unpooled endpoint for Alembic migrations. If omitted,
# migrations fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql+asyncpg://user:password@direct-host/dbname?sslmode=require

# FastAPI Backend
SECRET_KEY=your-super-secret-production-key-change-this
API_V1_STR=/api/v1
PROJECT_NAME="LinguaBridge API"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
ENVIRONMENT=production

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Admin bootstrap (consumed by backend/create_admin.py only when you run it).
# The script refuses empty, short (<12 chars) or known-default passwords and
# never prints the value back.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=generate-a-strong-one-secrets.token_urlsafe-24
ADMIN_FULL_NAME=Site Administrator

# Docker Registry
BACKEND_IMAGE=ghcr.io/yourusername/langapp-backend:latest
FRONTEND_IMAGE=ghcr.io/yourusername/langapp-frontend:latest

# PostgreSQL (if using local DB)
POSTGRES_DB=langapp
POSTGRES_USER=langapp
POSTGRES_PASSWORD=secure-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Deployment
DEPLOY_HOST=your-server-ip
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=your-ssh-private-key
DEPLOY_PORT=22

# Neon (for database deployments)
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id